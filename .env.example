# Local defaults only. Copy to .env.local for web and API.
VITE_API_BASE_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=5173
WEB_PREVIEW_PORT=5174
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# DEV-006 standalone spike only. No automatic paid-model fallback.
# Recheck model tools/availability against the provider catalog before a real run.
SPIKE_PROVIDER=openrouter
SPIKE_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_API_KEY=

# Local persistence (DEV-002). Relative paths resolve from the repository root.
# The database and artifact files stay in the gitignored data directory.
DATA_DIR=data
DATABASE_PATH=data/app.sqlite3
ARTIFACT_DIR=data/artifacts

# Worker (DEV-004). none = only reconcile leases/quota; fake = LABELLED dry-run runtime.
WORKER_RUNTIME=none
WORKER_LEASE_S=30

# Agent models (DEV-007). Copy agents/models.example.json to agents/models.json (gitignored) to set a model per role.
# Provider keys come only from the environment variable named in that file (for example OPENROUTER_API_KEY).
# WORKER_RUNTIME=structured runs PO/lead through that config; real PO qualification remains DEV-015.
AGENT_MODELS_FILE=

# DEV-010 opt-in product pipeline (Linux/macOS; use WSL on Windows).
# Prefer absolute paths on the Linux filesystem, not /mnt/c.
# Build the pinned runner image using contracts/verification/Dockerfile first.
# Configure each NEW project explicitly; see docs/decisions/pipeline.md.
# WORKER_RUNTIME=pipeline
PIPELINE_WORKSPACE_ROOT=data/pipeline-workspaces
PIPELINE_RUNNER_IMAGE=aiagent-verification:1.63.0
HERMES_PYTHON=

# DEV-011: generated-app preview is served on http://localhost:<PREVIEW_PORT> (never on the 127.0.0.1 control host).
PREVIEW_PORT=5180
