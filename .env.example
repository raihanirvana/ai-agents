# Local defaults only. Copy to .env.local for web and API.
VITE_API_BASE_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=5173
WEB_PREVIEW_PORT=5174
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# DEV-006 standalone spike only. No automatic paid-model fallback.
# Recheck model tools/availability against the provider catalog before a real run.
SPIKE_PROVIDER=openrouter
SPIKE_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_API_KEY=
